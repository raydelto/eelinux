# Progressive PAL at 50 Hz is confirmed stable on the project's tested HDMI
# setup. Choose MODE=pal for interlaced compatibility, or MODE=auto for EDID.
# MODE=boot keeps whatever mode the kernel booted with; NTSC media uses it so
# EELINUX.ELF stays at 480p and the EENTSC.ELF fallback stays interlaced.
# Setting MODE=480p on NTSC media would also force the interlaced fallback
# back to 480p.
MODE=576p
RGB_SOG=0
