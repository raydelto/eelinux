# The early-root helper selects the ext4 disk via eelinux.root= or /etc/eelinux-root.
/dev/root / ext4 defaults,noatime 0 0
proc /proc proc nosuid,nodev,noexec 0 0
sysfs /sys sysfs nosuid,nodev,noexec 0 0
devtmpfs /dev devtmpfs mode=0755,nosuid 0 0
devpts /dev/pts devpts mode=0620,gid=5,nosuid,noexec 0 0
tmpfs /run tmpfs mode=0755,nosuid,nodev,size=2M 0 0
tmpfs /tmp tmpfs mode=1777,nosuid,nodev,size=2M 0 0
tmpfs /dev/shm tmpfs mode=1777,nosuid,nodev,noexec,size=1M 0 0
