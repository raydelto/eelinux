Subject: [PATCH] linux-user: support glibc time64 pselect and MIPS termios2

--- a/linux-user/mips/termbits.h
+++ b/linux-user/mips/termbits.h
@@ -12,6 +12,18 @@
     unsigned int c_lflag;               /* local mode flags */
     unsigned char c_line;                    /* line discipline */
     unsigned char c_cc[TARGET_NCCS];                /* control characters */
+};
+
+/* The kernel termios2 ABI adds numeric input/output speeds after c_cc. */
+struct target_termios2 {
+    unsigned int c_iflag;
+    unsigned int c_oflag;
+    unsigned int c_cflag;
+    unsigned int c_lflag;
+    unsigned char c_line;
+    unsigned char c_cc[TARGET_NCCS];
+    unsigned int c_ispeed;
+    unsigned int c_ospeed;
 };
 
 /* c_iflag bits */
@@ -112,7 +124,8 @@
 #define  TARGET_B3000000 0010015
 #define  TARGET_B3500000 0010016
 #define  TARGET_B4000000 0010017
-#define TARGET_CIBAUD    002003600000  /* input baud rate (not used) */
+#define TARGET_CIBAUD    002003600000
+#define TARGET_IBSHIFT   16
 #define TARGET_CMSPAR    010000000000  /* mark or space (stick) parity */
 #define TARGET_CRTSCTS   020000000000  /* flow control */
 
@@ -222,10 +235,10 @@
 #define TARGET_TIOCSBRK	0x5427  /* BSD compatibility */
 #define TARGET_TIOCCBRK	0x5428  /* BSD compatibility */
 #define TARGET_TIOCGSID	0x7416  /* Return the session ID of FD */
-#define TARGET_TCGETS2          TARGET_IOR('T', 0x2A, struct termios2)
-#define TARGET_TCSETS2          TARGET_IOW('T', 0x2B, struct termios2)
-#define TARGET_TCSETSW2         TARGET_IOW('T', 0x2C, struct termios2)
-#define TARGET_TCSETSF2         TARGET_IOW('T', 0x2D, struct termios2)
+#define TARGET_TCGETS2          TARGET_IOR('T', 0x2A, struct target_termios2)
+#define TARGET_TCSETS2          TARGET_IOW('T', 0x2B, struct target_termios2)
+#define TARGET_TCSETSW2         TARGET_IOW('T', 0x2C, struct target_termios2)
+#define TARGET_TCSETSF2         TARGET_IOW('T', 0x2D, struct target_termios2)
 #define TARGET_TIOCGRS485       TARGET_IOR('T', 0x2E, struct serial_rs485)
 #define TARGET_TIOCSRS485       TARGET_IOWR('T', 0x2F, struct serial_rs485)
 #define TARGET_TIOCGPTN	TARGET_IOR('T',0x30, unsigned int) /* Get Pty Number (of pty-mux device) */
--- a/linux-user/syscall_types.h
+++ b/linux-user/syscall_types.h
@@ -1,4 +1,7 @@
 STRUCT_SPECIAL(termios)
+#if defined(TARGET_MIPS) && defined(TCGETS2)
+STRUCT_SPECIAL(termios2)
+#endif
 
 STRUCT(winsize,
        TYPE_SHORT, TYPE_SHORT, TYPE_SHORT, TYPE_SHORT)
--- a/linux-user/ioctls.h
+++ b/linux-user/ioctls.h
@@ -4,6 +4,12 @@
      IOCTL(TCSETS, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios)))
      IOCTL(TCSETSF, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios)))
      IOCTL(TCSETSW, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios)))
+#if defined(TARGET_MIPS) && defined(TCGETS2)
+     IOCTL(TCGETS2, IOC_R, MK_PTR(MK_STRUCT(STRUCT_termios2)))
+     IOCTL(TCSETS2, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios2)))
+     IOCTL(TCSETSW2, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios2)))
+     IOCTL(TCSETSF2, IOC_W, MK_PTR(MK_STRUCT(STRUCT_termios2)))
+#endif
      IOCTL(TIOCGWINSZ, IOC_R, MK_PTR(MK_STRUCT(STRUCT_winsize)))
      IOCTL(TIOCSWINSZ, IOC_W, MK_PTR(MK_STRUCT(STRUCT_winsize)))
      IOCTL(FIONREAD, IOC_R, MK_PTR(TYPE_INT))
--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -1243,7 +1243,8 @@
 }
 #endif
 
-#if defined(TARGET_NR_clock_settime64) || defined(TARGET_NR_futex_time64)
+#if defined(TARGET_NR_clock_settime64) || defined(TARGET_NR_futex_time64) || \
+    defined(TARGET_NR_pselect6_time64)
 static inline abi_long target_to_host_timespec64(struct timespec *host_ts,
                                                  abi_ulong target_addr)
 {
@@ -1254,6 +1255,11 @@
     }
     __get_user(host_ts->tv_sec, &target_ts->tv_sec);
     __get_user(host_ts->tv_nsec, &target_ts->tv_nsec);
+#if TARGET_ABI_BITS == 32
+    /* Linux's 32-bit timespec64 uses a 32-bit long for tv_nsec.  The high
+     * word is padding in libc's ABI and is ignored by the target kernel. */
+    host_ts->tv_nsec = (int32_t)host_ts->tv_nsec;
+#endif
     unlock_user_struct(target_ts, target_addr, 0);
     return 0;
 }
@@ -5446,6 +5452,42 @@
 	{ TARGET_CBAUD, TARGET_B115200, CBAUD, B115200 },
 	{ TARGET_CBAUD, TARGET_B230400, CBAUD, B230400 },
 	{ TARGET_CBAUD, TARGET_B460800, CBAUD, B460800 },
+#if defined(TARGET_BOTHER) && defined(BOTHER)
+	{ TARGET_CBAUD, TARGET_BOTHER, CBAUD, BOTHER },
+#endif
+#if defined(TARGET_B500000) && defined(B500000)
+	{ TARGET_CBAUD, TARGET_B500000, CBAUD, B500000 },
+#endif
+#if defined(TARGET_B576000) && defined(B576000)
+	{ TARGET_CBAUD, TARGET_B576000, CBAUD, B576000 },
+#endif
+#if defined(TARGET_B921600) && defined(B921600)
+	{ TARGET_CBAUD, TARGET_B921600, CBAUD, B921600 },
+#endif
+#if defined(TARGET_B1000000) && defined(B1000000)
+	{ TARGET_CBAUD, TARGET_B1000000, CBAUD, B1000000 },
+#endif
+#if defined(TARGET_B1152000) && defined(B1152000)
+	{ TARGET_CBAUD, TARGET_B1152000, CBAUD, B1152000 },
+#endif
+#if defined(TARGET_B1500000) && defined(B1500000)
+	{ TARGET_CBAUD, TARGET_B1500000, CBAUD, B1500000 },
+#endif
+#if defined(TARGET_B2000000) && defined(B2000000)
+	{ TARGET_CBAUD, TARGET_B2000000, CBAUD, B2000000 },
+#endif
+#if defined(TARGET_B2500000) && defined(B2500000)
+	{ TARGET_CBAUD, TARGET_B2500000, CBAUD, B2500000 },
+#endif
+#if defined(TARGET_B3000000) && defined(B3000000)
+	{ TARGET_CBAUD, TARGET_B3000000, CBAUD, B3000000 },
+#endif
+#if defined(TARGET_B3500000) && defined(B3500000)
+	{ TARGET_CBAUD, TARGET_B3500000, CBAUD, B3500000 },
+#endif
+#if defined(TARGET_B4000000) && defined(B4000000)
+	{ TARGET_CBAUD, TARGET_B4000000, CBAUD, B4000000 },
+#endif
 	{ TARGET_CSIZE, TARGET_CS5, CSIZE, CS5 },
 	{ TARGET_CSIZE, TARGET_CS6, CSIZE, CS6 },
 	{ TARGET_CSIZE, TARGET_CS7, CSIZE, CS7 },
@@ -5554,6 +5596,55 @@
     .size = { sizeof(struct target_termios), sizeof(struct host_termios) },
     .align = { __alignof__(struct target_termios), __alignof__(struct host_termios) },
 };
+
+#if defined(TARGET_MIPS) && defined(TCGETS2)
+static void target_to_host_termios2(void *dst, const void *src)
+{
+    struct termios2 *host = dst;
+    const struct target_termios2 *target = src;
+    struct host_termios legacy;
+    uint32_t input_baud = (tswap32(target->c_cflag) & TARGET_CIBAUD) >>
+                          TARGET_IBSHIFT;
+
+    target_to_host_termios(&legacy, src);
+    host->c_iflag = legacy.c_iflag;
+    host->c_oflag = legacy.c_oflag;
+    host->c_cflag = legacy.c_cflag |
+        ((target_to_host_bitmask(input_baud, cflag_tbl) << IBSHIFT) & CIBAUD);
+    host->c_lflag = legacy.c_lflag;
+    host->c_line = legacy.c_line;
+    memcpy(host->c_cc, legacy.c_cc, sizeof(host->c_cc));
+    host->c_ispeed = tswap32(target->c_ispeed);
+    host->c_ospeed = tswap32(target->c_ospeed);
+}
+
+static void host_to_target_termios2(void *dst, const void *src)
+{
+    struct target_termios2 *target = dst;
+    const struct termios2 *host = src;
+    struct host_termios legacy;
+    uint32_t input_baud = (host->c_cflag & CIBAUD) >> IBSHIFT;
+
+    legacy.c_iflag = host->c_iflag;
+    legacy.c_oflag = host->c_oflag;
+    legacy.c_cflag = host->c_cflag;
+    legacy.c_lflag = host->c_lflag;
+    legacy.c_line = host->c_line;
+    memcpy(legacy.c_cc, host->c_cc, sizeof(legacy.c_cc));
+    host_to_target_termios(dst, &legacy);
+    target->c_cflag |= tswap32(
+        (host_to_target_bitmask(input_baud, cflag_tbl) << TARGET_IBSHIFT) &
+        TARGET_CIBAUD);
+    target->c_ispeed = tswap32(host->c_ispeed);
+    target->c_ospeed = tswap32(host->c_ospeed);
+}
+
+static const StructEntry struct_termios2_def = {
+    .convert = { host_to_target_termios2, target_to_host_termios2 },
+    .size = { sizeof(struct target_termios2), sizeof(struct termios2) },
+    .align = { __alignof__(struct target_termios2), __alignof__(struct termios2) },
+};
+#endif
 
 static bitmask_transtbl mmap_flags_tbl[] = {
     { TARGET_MAP_SHARED, TARGET_MAP_SHARED, MAP_SHARED, MAP_SHARED },
@@ -8887,8 +8978,13 @@
 #endif
         return ret;
 #endif
+#if defined(TARGET_NR_pselect6) || defined(TARGET_NR_pselect6_time64)
 #ifdef TARGET_NR_pselect6
     case TARGET_NR_pselect6:
+#endif
+#ifdef TARGET_NR_pselect6_time64
+    case TARGET_NR_pselect6_time64:
+#endif
         {
             abi_long rfd_addr, wfd_addr, efd_addr, n, ts_addr;
             fd_set rfds, wfds, efds;
@@ -8932,7 +9028,12 @@
              * use the do_select() helper ...
              */
             if (ts_addr) {
-                if (target_to_host_timespec(&ts, ts_addr)) {
+                if (
+#ifdef TARGET_NR_pselect6_time64
+                    num == TARGET_NR_pselect6_time64 ?
+                    target_to_host_timespec64(&ts, ts_addr) :
+#endif
+                    target_to_host_timespec(&ts, ts_addr)) {
                     return -TARGET_EFAULT;
                 }
                 ts_ptr = &ts;
@@ -8984,8 +9085,16 @@
                 if (efd_addr && copy_to_user_fdset(efd_addr, &efds, n))
                     return -TARGET_EFAULT;
 
-                if (ts_addr && host_to_target_timespec(ts_addr, &ts))
+                if (ts_addr &&
+#ifdef TARGET_NR_pselect6_time64
+                    (num == TARGET_NR_pselect6_time64 ?
+                     host_to_target_timespec64(ts_addr, &ts) :
+                     host_to_target_timespec(ts_addr, &ts))) {
+#else
+                    host_to_target_timespec(ts_addr, &ts)) {
+#endif
                     return -TARGET_EFAULT;
+                }
             }
         }
         return ret;
--- a/linux-user/strace.list
+++ b/linux-user/strace.list
@@ -88,6 +88,9 @@
 #ifdef TARGET_NR_clock_gettime
 { TARGET_NR_clock_gettime, "clock_gettime" , NULL, NULL, NULL },
 #endif
+#ifdef TARGET_NR_clock_gettime64
+{ TARGET_NR_clock_gettime64, "clock_gettime64" , NULL, NULL, NULL },
+#endif
 #ifdef TARGET_NR_clock_nanosleep
 { TARGET_NR_clock_nanosleep, "clock_nanosleep" , NULL, NULL, NULL },
 #endif
@@ -1061,6 +1064,9 @@
 #ifdef TARGET_NR_pselect6
 { TARGET_NR_pselect6, "pselect6" , NULL, NULL, NULL },
 #endif
+#ifdef TARGET_NR_pselect6_time64
+{ TARGET_NR_pselect6_time64, "pselect6_time64" , NULL, NULL, NULL },
+#endif
 #ifdef TARGET_NR_ptrace
 { TARGET_NR_ptrace, "ptrace" , NULL, NULL, NULL },
 #endif
