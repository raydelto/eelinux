--- a/pcsx2-qt/QtKeyCodes.cpp
+++ b/pcsx2-qt/QtKeyCodes.cpp
@@ -566,6 +566,33 @@
 
 u32 QtUtils::KeyEventToCode(const QKeyEvent* ev)
 {
+#ifdef _WIN32
+	// USB keyboards carry physical keys. Shifted host text is layout-dependent:
+	// mapping a UK double quote to the US apostrophe key corrupts the guest map.
+	// Windows native scan codes retain positions on both press and release.
+	if (!(ev->modifiers() & Qt::KeypadModifier))
+	{
+		const u32 scan = ev->nativeScanCode();
+		if (scan >= 0x02 && scan <= 0x0b)
+			return (scan == 0x0b) ? Qt::Key_0 : Qt::Key_1 + scan - 0x02;
+		switch (scan)
+		{
+			case 0x0c: return Qt::Key_Minus;
+			case 0x0d: return Qt::Key_Equal;
+			case 0x1a: return Qt::Key_BracketLeft;
+			case 0x1b: return Qt::Key_BracketRight;
+			case 0x27: return Qt::Key_Semicolon;
+			case 0x28: return Qt::Key_Apostrophe;
+			case 0x29: return Qt::Key_Agrave;
+			case 0x2b: return Qt::Key_Backslash;
+			case 0x33: return Qt::Key_Comma;
+			case 0x34: return Qt::Key_Period;
+			case 0x35: return Qt::Key_Slash;
+			case 0x56: return Qt::Key_Less; // ISO key, HID usage 0x64.
+			default: break; // Extended keypad/navigation keys keep upstream handling.
+		}
+	}
+#endif
 	Qt::KeyboardModifiers modifiers = ev->modifiers();
 	const QString text = ev->text();
 	// Map special text symbols to keycodes if we're using Shift modifier.
