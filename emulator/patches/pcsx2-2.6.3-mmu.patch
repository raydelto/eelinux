+// SPDX-License-Identifier: GPL-3.0+
+// R5900/TX79 TLB matching, level-1 vectors and interpreter Random semantics.
+#pragma once
+
+#include <cstdint>
+
+namespace R5900::MMU
+{
+	// EXL/ERL force kernel mode regardless of Status.KSU.
+	constexpr bool AddressAllowed(std::uint32_t address, std::uint32_t status)
+	{
+		if ((status & 0x06) || (status & 0x18) == 0)
+			return true;
+		if ((status & 0x18) == 0x08) // Supervisor: kuseg and ksseg.
+			return address < 0x80000000 || (address >= 0xc0000000 && address < 0xe0000000);
+		return address < 0x80000000; // User; reserved KSU=3 has no extra privileges.
+	}
+
+	constexpr bool Matches(std::uint32_t entry_hi, std::uint32_t page_mask,
+		bool global, std::uint32_t address, std::uint8_t asid, bool scratchpad = false)
+	{
+		const std::uint32_t pair_mask = scratchpad ? 0x3fff : ((page_mask & 0x01ffe000) | 0x1fff);
+		return (entry_hi & ~pair_mask) == (address & ~pair_mask) &&
+			(global || static_cast<std::uint8_t>(entry_hi) == asid);
+	}
+
+	constexpr std::uint32_t ExceptionOffset(std::uint32_t code, bool refill, bool exl)
+	{
+		if (exl)
+			return 0x180;
+		const std::uint32_t exception = code & 0x7c;
+		if ((exception == 0x08 || exception == 0x0c) && refill)
+			return 0x000;
+		return exception == 0 ? 0x200 : 0x180;
+	}
+
+	constexpr std::uint32_t NextRandom(std::uint32_t current, std::uint32_t wired)
+	{
+		return current <= (wired & 0x3f) || current > 47 ? 47 : current - 1;
+	}
+
+	constexpr bool RandomIndexWritable(std::uint32_t index, std::uint32_t wired)
+	{
+		return index < 48 && index >= (wired & 0x3f);
+	}
+	// Raw entries keep this resolver independent of emulator storage/layout.
+	struct Entry
+	{
+		std::uint32_t mask, hi, lo0, lo1;
+	};
+
+	enum class AccessContext { Host, Fetch, Data };
+	enum class Translation { Physical, Scratchpad, AddressError, Refill, Invalid, Modified };
+	struct Resolution
+	{
+		Translation kind;
+		std::uint32_t physical;
+		std::uint8_t cache_mode;
+		int index;
+	};
+
+	// The caller checks faults before accessing either memory, cache or MMIO.
+	template <typename ReadEntry>
+	constexpr Resolution Resolve(std::uint32_t address, std::uint32_t status,
+		std::uint32_t config, std::uint8_t asid, bool store, ReadEntry read_entry,
+		unsigned count = 48)
+	{
+		if (!AddressAllowed(address, status))
+			return {Translation::AddressError, 0, 2, -1};
+		if ((status & 4) && address < 0x80000000) // ERL: direct, uncached kuseg.
+			return {Translation::Physical, address, 2, -1};
+		if (address >= 0x80000000 && address < 0xa0000000)
+			return {Translation::Physical, address & 0x1fffffff, static_cast<std::uint8_t>(config & 7), -1};
+		if (address >= 0xa0000000 && address < 0xc0000000)
+			return {Translation::Physical, address & 0x1fffffff, 2, -1};
+		for (unsigned index = 0; index < count; ++index)
+		{
+			const Entry entry = read_entry(index);
+			const bool scratchpad = (entry.lo0 & 0x80000000) != 0;
+			const bool global = (entry.lo0 & entry.lo1 & 1) != 0;
+			if (!Matches(entry.hi, entry.mask, global, address, asid, scratchpad))
+				continue;
+			// SPR spans 16 KiB; both halves must have equal V/D on hardware.
+			const std::uint32_t half_mask = scratchpad ? 0x1fff :
+				(((entry.mask & 0x01ffe000) | 0x1fff) >> 1);
+			const std::uint32_t lo = (address & (half_mask + 1)) ? entry.lo1 : entry.lo0;
+			if (!(lo & 2))
+				return {Translation::Invalid, 0, 2, static_cast<int>(index)};
+			if (store && !(lo & 4))
+				return {Translation::Modified, 0, 2, static_cast<int>(index)};
+			if (scratchpad)
+				return {Translation::Scratchpad, address & 0x3fff, 2, static_cast<int>(index)};
+			const std::uint32_t physical = (((lo & 0x03ffffc0) << 6) & ~half_mask) |
+				(address & half_mask);
+			return {Translation::Physical, physical, static_cast<std::uint8_t>((lo >> 3) & 7), static_cast<int>(index)};
+		}
+		return {Translation::Refill, 0, 2, -1};
+	}
+}
