 // See recVTLB.cpp for the dynarec versions.
 
+// Enforce segment privileges before either pointer or handler access.
+// External tools use the separate vtlb_ramRead/memSafeRead interfaces.
+static __fi void CheckInterpreterAddress(u32 address, bool store)
+{
+	if (Cpu == &intCpu && cpuMemoryContext != R5900::MMU::AccessContext::Host &&
+		!R5900::MMU::AddressAllowed(address, cpuRegs.CP0.n.Status.val))
+	{
+		cpuAddressError(address, store, cpuRegs.branch);
+		Cpu->CancelInstruction();
+	}
+}
+
+static thread_local bool guestPhysicalCacheable;
+
+VTLBVirtual vtlb_ResolveInterpreterMapping(u32 address, bool store, bool* cached)
+{
+	const bool guest = Cpu == &intCpu && cpuMemoryContext != R5900::MMU::AccessContext::Host;
+	if (!guest)
+	{
+		*cached = CheckCache(address);
+		return vtlbdata.vmap[address >> VTLB_PAGE_BITS];
+	}
+	CheckInterpreterAddress(address, store);
+	const auto result = R5900::MMU::Resolve(address, cpuRegs.CP0.n.Status.val, cpuRegs.CP0.n.Config,
+		static_cast<u8>(cpuRegs.CP0.n.EntryHi), store, [](unsigned index) {
+			return R5900::MMU::Entry{tlb[index].PageMask.UL, tlb[index].EntryHi.UL,
+				tlb[index].EntryLo0.UL, tlb[index].EntryLo1.UL};
+		});
+	using R5900::MMU::Translation;
+	if (result.kind == Translation::AddressError)
+		cpuAddressError(address, store, cpuRegs.branch);
+	else if (result.kind == Translation::Refill || result.kind == Translation::Invalid)
+	{
+		if (store) cpuTlbMissW(address, cpuRegs.branch);
+		else cpuTlbMissR(address, cpuRegs.branch);
+	}
+	else if (result.kind == Translation::Modified)
+		cpuTlbModify(address, cpuRegs.branch);
+	else
+	{
+		*cached = guestPhysicalCacheable = result.cache_mode == 3 && (cpuRegs.CP0.n.Config & 0x10000);
+		const u32 virtualPage = address & ~VTLB_PAGE_MASK;
+		if (result.kind == Translation::Scratchpad)
+			return VTLBVirtual::fromPointer(reinterpret_cast<uptr>(eeMem->Scratch) +
+				(result.physical & ~VTLB_PAGE_MASK), virtualPage);
+		const u32 physicalPage = result.physical & ~VTLB_PAGE_MASK;
+		const auto physical = result.physical < VTLB_PMAP_SZ ? vtlbdata.pmap[result.physical >> VTLB_PAGE_BITS] :
+			VTLBPhysical::fromHandler(UnmappedPhyHandler);
+		return VTLBVirtual(physical, physicalPage, virtualPage);
+	}
+	// No pointer, cache or device access is allowed after a translation fault.
+	Cpu->CancelInstruction();
+	return VTLBVirtual(); // CancelInstruction does not return.
+}
+
+static bool CacheablePhysicalAccess(u32 address)
+{
+	return Cpu == &intCpu && cpuMemoryContext != R5900::MMU::AccessContext::Host ?
+		guestPhysicalCacheable : CheckCache(address);
+}
