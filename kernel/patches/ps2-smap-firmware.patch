+#define EMAC_RX_ALLMULTI BIT(23)
+#define EMAC_RX_MULTICAST BIT(19)
+#define EMAC_IRQ_ALL 0x03ff03fbu
+#define EMAC_IRQ_DEAD (BIT(9) | BIT(8) | BIT(5))
+#define EMAC_MDIO_DONE BIT(15)
