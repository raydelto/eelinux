@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_PS2_GS_BATCH_H
+#define _UAPI_PS2_GS_BATCH_H
+#include "ps2-gs-logic.h"
+#define PS2GS_HW_SOLID_BATCH (1U << 11)
+/* Bounded, ordered solid operations with one shared target. Every rectangle
+ * is snapshotted and validated before drawing. Native RGB bits, masks and
+ * Boolean operations retain SOLID_LOGIC semantics, including preserved alpha.
+ * No pixel staging, raw packets, registers or physical addresses are exposed. */
+struct ps2gs_solid_batch {
+	__u32 abi, handle, count, plane_mask;
+	__u32 alu, width, height, bits_per_pixel;
+	__aligned_u64 rectangles;
+};
+#define PS2GS_SOLID_BATCH _IOW('G', 0x7e, struct ps2gs_solid_batch)
+#endif
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-batch-packet.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Each existing typed packet uses at most 32 qwords. Eight joined packets
+ * occupy at most 242 qwords including one tag and the final FINISH. Keep the
+ * existing 256-qword DMA allocation and bound time spent under the IRQ lock. */
+#define PS2GS_DMA_BATCH_COUNT 8
+#define PS2GS_INTERNAL_BATCH (~0U)
+struct ps2gs_draw_batch {
+	u32 operation, count, mask, mode;
+	const void *requests;
+	const struct ps2gs_buffer *texture;
+};
+static size_t ps2gs_package_batch(union package *base,
+		const struct ps2gs_buffer *color, const struct ps2gs_buffer *depth,
+		const struct ps2gs_draw_batch *batch)
+{
+	union package one[32], *p = base + 1;
+	u32 i;
+	for (i = 0; i < batch->count; ++i) {
+		size_t n;
+		if (batch->operation == PS2GS_SOLID_LOGIC)
+			n = ps2gs_package_solid_logic(one, color,
+				(const struct ps2gs_solid_logic *)batch->requests + i);
+		else if (batch->operation == PS2GS_RENDER_SUBMIT)
+			n = ps2gs_package_render(one, color, depth,
+				(const struct ps2gs_command *)batch->requests + i);
+		else if (batch->operation == PS2GS_TEXTURE_SUBMIT)
+			n = ps2gs_package_texture(one, color, depth, batch->texture,
+				(const struct ps2gs_texture_triangle *)batch->requests + i);
+		else
+			n = ps2gs_package_transfer(one, color, batch->texture,
+				(const struct ps2gs_texture_triangle *)batch->requests + i,
+				batch->mask, batch->mode);
+		/* Omit each private GIF tag and FINISH; preserve every state and
+		 * primitive word in order, then wait once for the combined packet. */
+		memcpy(p, one + 1, (n - 2) * sizeof(*p));
+		p += n - 2;
+	}
+	GIF_PACKAGE_AD(p) { .addr = gs_addr_finish };
+	base->gif.tag = (struct gif_tag) { .flg = gif_packed_mode,
+		.reg0 = gif_reg_ad, .nreg = 1, .nloop = p - base - 1, .eop = 1 };
+	return p - base;
+}
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-batch-device.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+static int ps2gs_execute_draw_batch(struct fb_info *info, u32 operation,
+		const struct ps2gs_buffer *depth, const struct ps2gs_buffer *color,
+		const void *requests, u32 count, const struct ps2gs_buffer *texture,
+		u32 mask, u32 mode)
+{
+	u32 stride = operation == PS2GS_SOLID_LOGIC ? sizeof(struct ps2gs_solid_logic) :
+		operation == PS2GS_RENDER_SUBMIT ? sizeof(struct ps2gs_command) :
+		sizeof(struct ps2gs_texture_triangle);
+	u32 i;
+	for (i = 0; i < count; i += PS2GS_DMA_BATCH_COUNT) {
+		struct ps2gs_draw_batch batch = { .operation = operation,
+			.count = min_t(u32, count - i, PS2GS_DMA_BATCH_COUNT),
+			.requests = (const u8 *)requests + i * stride,
+			.texture = texture, .mask = mask, .mode = mode };
+		int ret = ps2gs_surface_execute(info, PS2GS_INTERNAL_BATCH, depth, color, &batch, NULL);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+static int ps2gs_solid_batch_locked(struct ps2gs_session *session,
+		struct fb_info *info, void __user *arg)
+{
+	struct ps2gs_solid_batch request;
+	struct ps2gs_solid_logic *rectangles;
+	struct ps2gs_buffer front, *color;
+	u32 i;
+	int ret;
+	if (copy_from_user(&request, arg, sizeof(request)))
+		return -EFAULT;
+	if (request.abi != PS2GS_ABI_VERSION || !request.count ||
+	    request.count > PS2GS_MAX_COMMANDS || request.alu > 15)
+		return -EINVAL;
+	color = ps2gs_session_buffer(session, info, request.handle, &front);
+	if (!color)
+		return -ENOENT;
+	if (request.width != color->width || request.height != color->height ||
+	    request.bits_per_pixel != color->bits_per_pixel)
+		return -ESTALE;
+	if (request.rectangles >> 32)
+		return -EFAULT;
+	rectangles = memdup_user(u64_to_user_ptr(request.rectangles), request.count * sizeof(*rectangles));
+	if (IS_ERR(rectangles))
+		return PTR_ERR(rectangles);
+	for (i = 0; i < request.count; ++i) {
+		if (rectangles[i].handle != request.handle ||
+		    rectangles[i].plane_mask != request.plane_mask || rectangles[i].alu != request.alu) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = ps2gs_validate_solid_logic(color, rectangles + i);
+		if (ret)
+			goto out;
+	}
+	ret = ps2gs_execute_draw_batch(info, PS2GS_SOLID_LOGIC, NULL, color,
+		rectangles, request.count, NULL, 0, 0);
+	if (ret)
+		session->failed = ret;
+out:
+	kfree(rectangles);
+	return ret;
+}
