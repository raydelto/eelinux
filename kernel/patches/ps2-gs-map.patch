--- /dev/null
+++ b/include/uapi/linux/ps2-gs-map.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_PS2_GS_MAP_H
+#define _UAPI_PS2_GS_MAP_H
+#include "ps2-gs-lut.h"
+#define PS2GS_HW_CHANNEL_MAP (1U << 13)
+/* Map one selected source byte through an owned RGBA palette. All selected
+ * destination bits, including alpha, are replaced; other bits are preserved.
+ * Three distinct owned surfaces: source/destination 64x32 CT32 and palette
+ * 16x16 CT32. No user addresses or registers. Rectangles start at the origin. */
+struct ps2gs_channel_map {
+	__u32 abi, source, destination, palette;
+	__u32 width, height, plane_mask, source_channel;
+};
+#define PS2GS_CHANNEL_MAP _IOW('G', 0x80, struct ps2gs_channel_map)
+#endif
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-map-packet.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* The indexed swizzle already addresses all four CT32 bytes. Enable RGBA
+ * DECAL so a palette entry can also replace alpha with its full eight bits.
+ * Keep the original RGB-only lookup packet and ABI unchanged. */
+static size_t ps2gs_package_map(union package *base,
+		const struct ps2gs_buffer *color, const struct ps2gs_lut_operation *op)
+{
+	size_t i, count = ps2gs_package_lut(base, color, op);
+	for (i = 1; i < count; ++i)
+		if (base[i].gif.doubleword[1] == gs_addr_tex0_2)
+			base[i].gif.doubleword[0] |= 1ULL << 34;
+	return count;
+}
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-map-device.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+static int ps2gs_map_locked(struct ps2gs_session *session,
+		struct fb_info *info, void __user *arg)
+{
+	struct ps2gs_channel_map r;
+	struct ps2gs_buffer *source, *destination, *palette;
+	u32 first, total;
+	int ret;
+	if (copy_from_user(&r, arg, sizeof(r)))
+		return -EFAULT;
+	if (r.abi != PS2GS_ABI_VERSION || r.source_channel > 3 || !r.width || !r.height ||
+	    r.width > 64 || r.height > 32 || !r.source || !r.destination || !r.palette ||
+	    r.source == r.destination || r.source == r.palette || r.destination == r.palette)
+		return -EINVAL;
+	source = ps2gs_arena_lookup(&session->arena, r.source);
+	destination = ps2gs_arena_lookup(&session->arena, r.destination);
+	palette = ps2gs_arena_lookup(&session->arena, r.palette);
+	if (!source || !destination || !palette)
+		return -ENOENT;
+	if (ps2gs_depth_role(session, r.source) || ps2gs_depth_role(session, r.destination) ||
+	    ps2gs_depth_role(session, r.palette) || source->bits_per_pixel != 32 ||
+	    destination->bits_per_pixel != 32 || palette->bits_per_pixel != 32 ||
+	    source->width != 64 || source->height != 32 || destination->width != 64 ||
+	    destination->height != 32 || palette->width != 16 || palette->height != 16 ||
+	    source->buffer_width != 64 || destination->buffer_width != 64 || palette->buffer_width != 64)
+		return -EOPNOTSUPP;
+	if (!r.plane_mask)
+		return 0;
+	total = DIV_ROUND_UP(r.width, 4) * DIV_ROUND_UP(r.height, 2);
+	for (first = 0; first < total; first += 48) {
+		struct ps2gs_lut_operation op = { .texture = source, .palette = palette,
+			.width = r.width, .height = r.height, .mask = r.plane_mask,
+			.channel = r.source_channel, .first = first,
+			.count = min_t(u32, total - first, 48) };
+		ret = ps2gs_surface_execute(info, PS2GS_CHANNEL_MAP, NULL, destination, &op, NULL);
+		if (ret) {
+			session->failed = ret;
+			return ret;
+		}
+	}
+	return 0;
+}
