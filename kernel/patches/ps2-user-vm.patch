+	pr_emerg("ps2 user fault: epc=%08lx ra=%08lx cause=%08lx\n",
+		 regs->cp0_epc, regs->regs[31], regs->cp0_cause);
+	pr_emerg("ps2 user fault: s0=%08lx s1=%08lx s2=%08lx s3=%08lx\n",
