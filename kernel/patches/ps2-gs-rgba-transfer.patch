+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_PS2_GS_RGBA_TRANSFER_H
+#define _UAPI_PS2_GS_RGBA_TRANSFER_H
+#include "ps2-gs-transfer.h"
+#define PS2GS_HW_RGBA_TRANSFER (1U << 15)
+#define PS2GS_RGBA_REPLACE 0U
+#define PS2GS_RGBA_MULTIPLY 1U
+/* Owned CT32 only, with the existing bounded texture geometry and ownership
+ * checks. REPLACE copies all four bytes under an arbitrary mask. MULTIPLY
+ * writes RGB = floor(texture.RGB * texture.A / 128), clamped to 255, with
+ * RGB-only masks. No arbitrary registers, depth writes or framebuffer access. */
+#define PS2GS_TEXTURE_RGBA_TRANSFER _IOW('G', 0x82, struct ps2gs_texture_transfer)
+#endif
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-rgba-transfer-packet.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+static size_t ps2gs_package_rgba_transfer(union package *base,
+		const struct ps2gs_buffer *color, const struct ps2gs_buffer *texture,
+		const struct ps2gs_texture_triangle *triangle, u32 mask, u32 mode)
+{
+	size_t i, count = ps2gs_package_transfer(base, color, texture, triangle, mask, PS2GS_TRANSFER_REPLACE);
+	bool frame = false;
+	for (i = 1; i < count; ++i) {
+		if (base[i].gif.packed.ad.addr == gs_addr_frame_2 && !frame) {
+			base[i].gif.packed.ad.data.frame_1.fbmsk = ~mask;
+			frame = true;
+		}
+		if (base[i].gif.packed.ad.addr == gs_addr_tex0_2)
+			base[i].gif.doubleword[0] |= 1ULL << 34;
+		if (mode == PS2GS_RGBA_MULTIPLY && base[i].gif.packed.ad.addr == gs_addr_alpha_2) {
+			base[i].gif.packed.ad.data.alpha_1.c = 0; /* texture alpha */
+			base[i].gif.packed.ad.data.alpha_1.d = 2; /* zero */
+		}
+		if (base[i].gif.packed.ad.addr == gs_addr_prim)
+			base[i].gif.packed.ad.data.prim.abe = mode == PS2GS_RGBA_MULTIPLY;
+	}
+	return count;
+}
--- /dev/null
+++ b/drivers/video/fbdev/ps2fb-gs-rgba-transfer-device.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+static int ps2gs_rgba_transfer_locked(struct ps2gs_session *session,
+		struct fb_info *info, void __user *arg)
+{
+	struct ps2gs_texture_transfer request;
+	struct ps2gs_texture_submit *r = &request.draw;
+	struct ps2gs_buffer *color, *texture;
+	struct ps2gs_texture_triangle *triangles;
+	u32 i;
+	int ret;
+	if (copy_from_user(&request, arg, sizeof(request)))
+		return -EFAULT;
+	if (r->abi != PS2GS_ABI_VERSION || !r->count ||
+	    r->count > PS2GS_MAX_COMMANDS || r->depth || request.mode > PS2GS_RGBA_MULTIPLY ||
+	    (request.mode == PS2GS_RGBA_MULTIPLY && (request.plane_mask & 0xff000000)))
+		return -EINVAL;
+	color = ps2gs_arena_lookup(&session->arena, r->target);
+	texture = ps2gs_arena_lookup(&session->arena, r->texture);
+	if (!color || !texture || ps2gs_depth_role(session, r->target) ||
+	    ps2gs_depth_role(session, r->texture))
+		return -ENOENT;
+	if (color->bits_per_pixel != 32 || texture->bits_per_pixel != 32)
+		return -EOPNOTSUPP;
+	if (r->width != color->width || r->height != color->height || r->bits_per_pixel != 32)
+		return -ESTALE;
+	if (r->triangles >> 32)
+		return -EFAULT;
+	triangles = memdup_user(u64_to_user_ptr(r->triangles), r->count * sizeof(*triangles));
+	if (IS_ERR(triangles))
+		return PTR_ERR(triangles);
+	for (i = 0; i < r->count; ++i) {
+		if (triangles[i].flags) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = ps2gs_validate_texture(color, NULL, 0, texture, &triangles[i]);
+		if (ret)
+			goto out;
+	}
+	ret = 0;
+	for (i = 0; request.plane_mask && i < r->count; ++i) {
+		struct ps2gs_transfer_operation operation = {
+			.texture = texture, .triangle = &triangles[i],
+			.mask = request.plane_mask, .mode = request.mode };
+		ret = ps2gs_surface_execute(info, PS2GS_TEXTURE_RGBA_TRANSFER, NULL, color, &operation, NULL);
+		if (ret) {
+			session->failed = ret;
+			break;
+		}
+	}
+out:
+	kfree(triangles);
+	return ret;
+}
