+{
+	const struct gs_rgbaq bg = { .r = 0x00, .g = 0x00, .b = 0x00, .a = 0x80 };
+	const union gif_data packages[] __attribute__((aligned(64))) = {
+		{
+			.tag = {
+				.flg = gif_reglist_mode,
+				.reg0 = gif_reg_prim,
+				.reg1 = gif_reg_rgbaq,
+				.reg2 = gif_reg_xyz2,
+				.reg3 = gif_reg_xyz2,
+				.nreg = 4,
+				.nloop = 1,
+				.eop = 1
+			}
+		},
+		{
+			.reg = {
+				.lo.prim = { .prim = gs_sprite },
+				.hi.rgbaq = bg
+			}
+		},
+		{
+			.reg = {
+				.lo.xyz2 = {
+					.x = gs_fbcs_to_pcs(0),
