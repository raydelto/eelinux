+static inline void __raw_writeq__(u64 val, volatile u64 *addr)		\
+{									\
+	u64 tmp;							\
+									\
+	__asm__ __volatile__(						\
+		".set	push"		"\t\t# __writeq""\n\t"		\
+		".set	mips3"				"\n\t"		\
+		"dsll32	%L0, %L0, 0"			"\n\t"		\
+		"dsrl32	%L0, %L0, 0"			"\n\t"		\
+		"dsll32	%M0, %M0, 0"			"\n\t"		\
+		"or	%L0, %L0, %M0"			"\n\t"		\
+		"sd	%L0, %2"			"\n\t"		\
+		"sll	%L0, %L0, 0"			"\n\t"		\
+		"sll	%M0, %M0, 0"			"\n\t"		\
+		".set	pop"				"\n"		\
+		: "=r" (tmp)						\
+		: "0" (val), "m" (*addr));				\
+}
