+#define SHOW_SYSFS_DECNUM_FIELD(field_, ...)				\
+	do {								\
+		if (valid)						\
+			n += scnprintf(&buf[n], PAGE_SIZE - n,		\
+				#field_ " %u\n", value.field_);		\
+		else							\
