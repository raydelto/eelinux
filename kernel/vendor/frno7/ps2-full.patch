+static void plot(int x, int y, bool v)
+{
+	const struct gs_rgbaq bg = { .r = 0x00, .g = 0x00, .b = 0x00, .a = 0x80 };
+	const struct gs_rgbaq fg = { .r = 0xff, .g = 0xff, .b = 0xff, .a = 0x80 };
+	const union gif_data packages[]__attribute__((aligned(64))) = {
+		{
+			.tag = {
+				.flg = gif_reglist_mode,
+				.reg0 = gif_reg_prim,
+				.nreg = 1,
+				.nloop = 1
+			}
+		},
+		{
+			.reg = {
+				.lo.prim = { .prim = gs_point }
+			}
+		},
+		{
+			.tag = {
+				.flg = gif_reglist_mode,
+				.reg0 = gif_reg_rgbaq,
+				.reg1 = gif_reg_xyz2,
+				.nreg = 2,
+				.nloop = 1,
+				.eop = 1
+			}
+		},
+		{
+			.reg = {
+				.lo.rgbaq = v ? fg : bg,
+				.hi.xyz2 = {
+					.x = gs_fbcs_to_pcs(x),
+					.y = gs_fbcs_to_pcs(y)
+				},
+			}
+		}
+	};
+
+	gif_write_FIXME(packages, ARRAY_SIZE(packages));
+}
+
+void prom_putchar(char c)
+{
+	static int row = 4, col = 0;
+
+	int x, y;
+
+	if (!IS_ENABLED(CONFIG_EARLY_PRINTK))
+		return;
+
+	if (IS_ENABLED(CONFIG_SERIAL_PS2_UART_CONSOLE))
+		wrb(c, SIO_TXFIFO);	/* Send to EE UART */
+
+	if (c == '\r') {
+		col = 0;
+		return;
+	}
+	if (c == '\n') {
+		col = 0;
+		row++;
+		return;
+	}
+
+	for (y = 0; y < 8; y++)
+	for (x = 0; x < 8; x++)
+		plot(col * 8 + x, row * 8 + y,
+			(acorndata_8x8[8 * (u8)c + y] & (0x80 >> x)) != 0);
+
+	col++;
+}
