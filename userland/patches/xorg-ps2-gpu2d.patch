+    error=errno;
+    if(!result && used)result=ps2_render_flush(target->render);
+    if(result)error=errno;
+    if(!result && emitted)*emitted=used;
+out:
+    free(plan);ps2_pipe_context_release(ctx);if(result)errno=error;return result;
+}
