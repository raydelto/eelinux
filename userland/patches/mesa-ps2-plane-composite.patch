+++ b/src/gallium/drivers/ps2/ps2_composite.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_PIPE_COMPOSITE_H
+#define PS2_PIPE_COMPOSITE_H
+#include "ps2_copy_batch.h"
+#include <stddef.h>
+enum ps2_picture_repeat { PS2_REPEAT_NONE, PS2_REPEAT_NORMAL, PS2_REPEAT_PAD, PS2_REPEAT_REFLECT };
+struct ps2_picture_sample {
+    int32_t matrix[3][3]; /* 16.16 source transform, evaluated at pixel centres. */
+    unsigned transformed, repeat;
+};
+struct ps2_picture_bitmap {
+    const unsigned char *bits;
+    size_t bytes, stride;
+    unsigned width, height, msb_first;
+    int32_t x, y;
+    struct ps2_picture_sample sample;
+};
+/* Opaque Src/Over, nearest affine transforms/repeat, optional binary alpha mask.
+ * Geometry only on CPU; source and destination colour pixels remain on GS.
+ * Missing Src samples clear; missing Over samples preserve destination RGB.
+ * Alias/front sources are snapshotted in VRAM before drawing. */
+int ps2_pipe_composite_rect(struct pipe_context *, uint32_t source, uint32_t destination,
+    const struct ps2_pipe_copy_box *, const struct ps2_picture_sample *,
+    const struct ps2_picture_bitmap *, unsigned over);
+#endif
--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_plane.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: MIT */
+#include "ps2_plane.h"
+#include "ps2_pipe.h"
+#include "ps2_rop.h"
+#include "ps2_gs_logic.h"
+#include "ps2_solid_batch.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RUNS 256U
+int ps2_pipe_plane_copy_boxes(struct pipe_context *ctx, uint32_t source,
+    uint32_t destination, const struct ps2_pipe_copy_box *input, unsigned count,
+    uint32_t plane, uint32_t foreground, uint32_t background,
+    uint32_t mask, unsigned alu)
+{
+    if (!ctx || count > PS2_PIPE_MAX_COPY_BOXES || (count && !input) || alu > 15) {
+        errno = EINVAL; return -1;
+    }
+    if (ps2_pipe_context_acquire(ctx)) return -1;
+    struct ps2_render_client *render = ps2_pipe_context_render(ctx);
+    struct ps2_surface_client *gs = render->gs;
+    const struct ps2_surface *s = ps2_surface_lookup(gs, source);
+    const struct ps2_surface *d = ps2_surface_lookup(gs, destination);
+    struct ps2_rop_workspace work = {0};
+    struct ps2_pipe_copy_box *boxes = NULL;
+    struct ps2_pipe_solid_run *runs = NULL;
+    unsigned char *snapshot = NULL, *packed = NULL;
+    int result = -1, error = EINVAL;
+    uint64_t area = 0;
+    if (!s || !d || !plane || (plane & (plane - 1)) ||
+        (plane & ~(s->bits_per_pixel == 16 ? 0x7fffU : 0xffffffU))) goto out;
+    uint32_t bits = d->bits_per_pixel == 16 ? 0x7fffU : 0xffffffU;
+    if (mask & ~bits) goto out;
+    for (unsigned i = 0; i < count; ++i) {
+        const struct ps2_pipe_copy_box *b = input + i;
+        if (b->sx < 0 || b->sy < 0 || b->dx < 0 || b->dy < 0 ||
+            b->width <= 0 || b->height <= 0 ||
+            (int64_t)b->sx + b->width > s->width || (int64_t)b->sy + b->height > s->height ||
+            (int64_t)b->dx + b->width > d->width || (int64_t)b->dy + b->height > d->height) goto out;
+        area += (uint64_t)b->width * b->height;
+        if (area > PS2_PIPE_MAX_COPY_PIXELS) { error = E2BIG; goto out; }
+    }
+    if (!count || !mask || alu == 5) { result = 0; goto out; }
+    if (!(gs->caps.features & PS2GS_HW_READBACK) || !(gs->caps.features & PS2GS_HW_SOLID_LOGIC)) {
+        error = ENOTSUP; goto out;
+    }
+    size_t stride = (s->width + 7) / 8, bytes = stride * s->height;
+    /* All host and VRAM allocations precede the shared queue fence. A source
+     * bitmap, bounded packet rows and bounded run batch are the only pixels
+     * retained in main RAM. No destination readback occurs, even for XOR. */
+    boxes = malloc(count * sizeof(*boxes));
+    snapshot = calloc(1, bytes);
+    packed = malloc(8192);
+    runs = malloc(RUNS * sizeof(*runs));
+    if (!boxes || !snapshot || !packed || !runs) { error = ENOMEM; goto out; }
+    memcpy(boxes, input, count * sizeof(*boxes));
+    if (ps2_rop_reserve(&work, gs, s->bits_per_pixel)) { error = errno; goto out; }
+    result = ps2_render_flush(render);
+    unsigned cpp = s->bits_per_pixel / 8;
+    /* Capture every clipped source before emitting any destination run. This
+     * makes self-copy and disjoint/overlapping clip rectangles deterministic. */
+    for (unsigned i = 0; !result && i < count; ++i) {
+        const struct ps2_pipe_copy_box *b = boxes + i;
+        for (unsigned y = 0; !result && y < (unsigned)b->height; y += 32)
+            for (unsigned x = 0; !result && x < (unsigned)b->width; x += 64) {
+                unsigned w = b->width - x, h = b->height - y;
+                if (w > 64) w = 64;
+                if (h > 32) h = 32;
+                result = ps2_surface_solid_logic(gs, work.destination, 0, 0, 64, 32, 0,
+                    s->bits_per_pixel == 16 ? 0x7fffU : 0xffffffU, 0);
+                if (!result) result = ps2_rop_rectangle(&work, source, work.destination,
+                    b->sx + x, b->sy + y, 0, 0, w, h, plane, 3);
+                if (!result) result = ps2_surface_download(gs, work.destination, 0, 0, 64, 32,
+                    packed, 64 * 32 * cpp);
+                if (!result) for (unsigned yy = 0; yy < h; ++yy) for (unsigned xx = 0; xx < w; ++xx) {
+                    uint32_t pixel = 0;
+                    memcpy(&pixel, packed + (yy * 64 + xx) * cpp, cpp);
+                    unsigned sx = b->sx + x + xx, sy = b->sy + y + yy;
+                    if (pixel) snapshot[sy * stride + sx / 8] |= 1U << (sx % 8);
+                }
+            }
+    }
+    foreground &= bits; background &= bits;
+    unsigned n = 0;
+    for (unsigned i = 0; !result && i < count; ++i) {
+        const struct ps2_pipe_copy_box *b = boxes + i;
+        for (unsigned y = 0; !result && y < (unsigned)b->height; ++y)
+            for (unsigned x = 0; !result && x < (unsigned)b->width;) {
+                unsigned start = x, sx = b->sx + x, sy = b->sy + y;
+                unsigned set = (snapshot[sy * stride + sx / 8] >> (sx % 8)) & 1;
+                uint32_t colour = set ? foreground : background;
+                do { ++x; sx = b->sx + x; }
+                while (x < (unsigned)b->width &&
+                    (((snapshot[sy * stride + sx / 8] >> (sx % 8)) & 1) ? foreground : background) == colour);
+                runs[n++] = (struct ps2_pipe_solid_run){
+                    .box = {b->dx + start, b->dy + y, b->dx + x, b->dy + y + 1}, .color = colour};
+                if (n == RUNS) { result = ps2_pipe_solid_runs(ctx, destination, runs, n, mask, alu); n = 0; }
+            }
+    }
+    if (!result && n) result = ps2_pipe_solid_runs(ctx, destination, runs, n, mask, alu);
+    error = errno;
+out:
+    if (work.gs && ps2_rop_release(&work) && !result) { result = -1; error = errno; }
+    free(runs); free(packed); free(snapshot); free(boxes);
+    ps2_pipe_context_release(ctx);
+    if (result) errno = error;
+    return result;
+}
