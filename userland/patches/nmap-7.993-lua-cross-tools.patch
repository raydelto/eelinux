Subject: [PATCH] Select the target archive tools for bundled Lua

--- a/Makefile.in
+++ b/Makefile.in
@@ -170,7 +170,7 @@
 	cd $(NCATDIR) && $(MAKE)
 
 build-lua: $(LIBLUADIR)/Makefile
-	@echo Compiling liblua; cd $(LIBLUADIR) && $(MAKE) liblua.a CC="$(CC)" MYCFLAGS="$(CFLAGS) @LUA_CFLAGS@"
+	@echo Compiling liblua; cd $(LIBLUADIR) && $(MAKE) liblua.a CC="$(CC)" AR="$(shell $(CC) -print-prog-name=ar) rcu" RANLIB="$(shell $(CC) -print-prog-name=ranlib)" MYCFLAGS="$(CFLAGS) @LUA_CFLAGS@"
 build-lua-bins: $(LIBLUADIR)/Makefile
 	@echo Compiling lua/luac; cd $(LIBLUADIR) && $(MAKE) all CC="$(CC)" MYCFLAGS="$(CFLAGS) @LUA_CFLAGS@" MYLDFLAGS="$(LDFLAGS)"
 
