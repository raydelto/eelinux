--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_solid_batch.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: MIT */
+#include "ps2_pipe.h"
+#include "ps2_solid_batch.h"
+#include "ps2_gs_logic.h"
+#include <errno.h>
+int ps2_pipe_solid_rectangles(struct pipe_context *context,uint32_t handle,
+    const struct ps2_pipe_solid_box *boxes,unsigned count,uint32_t color,uint32_t mask,unsigned alu)
+{
+    if(!context || count>PS2_PIPE_MAX_SOLID_BOXES || (count && !boxes) || alu>15) {
+        errno=EINVAL;return -1;
+    }
+    if(ps2_pipe_context_acquire(context)) return -1;
+    int status=-1,error=EINVAL;
+    struct ps2_render_client *render=ps2_pipe_context_render(context);
+    const struct ps2_surface *storage=render ? ps2_surface_lookup(render->gs,handle) : NULL;
+    if(!storage) goto out;
+    uint32_t bits=storage->bits_per_pixel==16 ? 0x7fff : 0xffffff;
+    if((color|mask)&~bits) goto out;
+    if(!(render->gs->caps.features & PS2GS_HW_SOLID_LOGIC)) { error=ENOTSUP;goto out; }
+    for(unsigned i=0;i<count;++i) {
+        const struct ps2_pipe_solid_box *b=boxes+i;
+        if(b->x1<0 || b->y1<0 || b->x2<=b->x1 || b->y2<=b->y1 ||
+            (unsigned)b->x2>storage->width || (unsigned)b->y2>storage->height) goto out;
+    }
+    if(!count || !mask || alu==5) { status=0;goto out; }
+    status=ps2_render_flush(render);
+    for(unsigned i=0;!status && i<count;++i) {
+        const struct ps2_pipe_solid_box *b=boxes+i;
+        status=ps2_surface_solid_logic(render->gs,handle,b->x1,b->y1,
+            b->x2-b->x1,b->y2-b->y1,color,mask,alu);
+    }
+    error=errno;
+out:
+    ps2_pipe_context_release(context);
+    if(status) errno=error;
+    return status;
+}
--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_solid_batch.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_PIPE_SOLID_BATCH_H
+#define PS2_PIPE_SOLID_BATCH_H
+#include <stdint.h>
+struct pipe_context;
+struct ps2_pipe_solid_box { int32_t x1,y1,x2,y2; };
+#define PS2_PIPE_MAX_SOLID_BOXES 16384U
+/* Explicit native adapter for file-owned color handles shared with Xorg.
+ * Preflight every box before fencing or drawing. Preserve Gallium color/depth
+ * bindings and references; lease the context through the entire submission.
+ * No GL capability is advertised, and no CPU pixel fallback is provided.
+ */
+int ps2_pipe_solid_rectangles(struct pipe_context *, uint32_t handle,
+    const struct ps2_pipe_solid_box *, unsigned count, uint32_t color,
+    uint32_t plane_mask, unsigned alu);
+#endif
