+        native_d->width!=dst->width0 || native_d->height!=dst->height0 ||
+        native_s->bits_per_pixel!=bpp || native_d->bits_per_pixel!=bpp) { reject(c,EINVAL); return; }
+    const struct ps2_pipe_blit_rect box={info->src.box.x,info->src.box.y,
