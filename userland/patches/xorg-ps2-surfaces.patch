+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_SURFACE_EXA_H
+#define PS2_SURFACE_EXA_H
+#include "xorg-server.h"
+#include "scrnintstr.h"
+#include "exa.h"
+#include "ps2_gs_surface.h"
+
+struct ps2_surface_exa {
+    struct ps2_surface_client *gs;
+    ExaDriverRec driver;
+    uint32_t color, source;
+};
+/* EXA storage/drawing callbacks for an owned GS session. Screen setup, front
+ * pixmap binding, cursor, glyph/composite and VT lifecycle are still DDX work.
+ * These callbacks are compiled/tested, not installed as ps2_drv.so. */
+Bool ps2_surface_exa_prepare(ScreenPtr, struct ps2_surface_exa *, struct ps2_surface_client *);
+#endif
