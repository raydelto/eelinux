--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_gs_bitmap.c
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: MIT */
+#include "ps2_gs_bitmap.h"
+#include <errno.h>
+#include <stdlib.h>
+
+#define MAX_GLYPHS 4096U
+#define MAX_CLIPS 256U
+#define MAX_PIXELS 1048576U
+#define MAX_SPANS 32768U
+struct span { uint16_t x,y,width,height; uint32_t color; };
+struct plan { struct span *spans; unsigned count,capacity; };
+static int invalid(int error) { errno=error; return -1; }
+static int append(struct plan *p,int64_t x,int64_t y,int64_t right,int64_t bottom,uint32_t color)
+{
+    if (right<=x || bottom<=y) return 0;
+    if (p->count==MAX_SPANS) return invalid(E2BIG);
+    if (p->count==p->capacity) {
+        unsigned capacity=p->capacity ? p->capacity*2 : 64;
+        struct span *spans=realloc(p->spans,capacity*sizeof(*spans));
+        if (!spans) return -1;
+        p->spans=spans; p->capacity=capacity;
+    }
+    p->spans[p->count++]=(struct span){x,y,right-x,bottom-y,color};
+    return 0;
+}
+static int rectangle(struct plan *p,const struct ps2_surface *surface,
+    const struct ps2_bitmap_box *clips,unsigned count,
+    int64_t x,int64_t y,int64_t right,int64_t bottom,uint32_t color)
+{
+    for(unsigned i=0;i<count;++i) {
+        int64_t a=x>clips[i].x1 ? x : clips[i].x1,b=y>clips[i].y1 ? y : clips[i].y1;
+        int64_t c=right<clips[i].x2 ? right : clips[i].x2,d=bottom<clips[i].y2 ? bottom : clips[i].y2;
+        if(a<0) a=0;
+        if(b<0) b=0;
+        if(c>surface->width) c=surface->width;
+        if(d>surface->height) d=surface->height;
+        if(append(p,a,b,c,d,color)) return -1;
+    }
+    return 0;
+}
+static int bit(const unsigned char *row,unsigned x,int msb)
+{ return !!(row[x/8] & (msb ? 0x80U>>(x%8) : 1U<<(x%8))); }
+int ps2_bitmap_draw(struct ps2_render_client *r,uint32_t target,
+    const struct ps2_bitmap_glyph *glyphs,unsigned count,
+    const struct ps2_bitmap_box *clips,unsigned clip_count,int msb_first,
+    uint32_t foreground,const struct ps2_bitmap_box *background,uint32_t background_color)
+{
+    if(!r || !r->gs) return invalid(EINVAL);
+    if(r->gs->error) return invalid(r->gs->error);
+    const struct ps2_surface *surface=ps2_surface_lookup(r->gs,target);
+    if(!surface || (count && !glyphs) || (clip_count && !clips) ||
+        count>MAX_GLYPHS || clip_count>MAX_CLIPS || (msb_first!=0 && msb_first!=1)) return invalid(EINVAL);
+    if(background && (background->x2<background->x1 || background->y2<background->y1)) return invalid(EINVAL);
+    for(unsigned i=0;i<clip_count;++i)
+        if(clips[i].x2<clips[i].x1 || clips[i].y2<clips[i].y1) return invalid(EINVAL);
+    size_t pixels=0;
+    for(unsigned i=0;i<count;++i) {
+        const struct ps2_bitmap_glyph *g=&glyphs[i];
+        if(g->width>256 || g->height>256) return invalid(ENOTSUP);
+        pixels+=(size_t)g->width*g->height;
+        if(pixels>MAX_PIXELS) return invalid(E2BIG);
+        if(!g->width || !g->height) continue;
+        size_t row=(g->width+7)/8;
+        if(!g->bits || g->stride<row || g->height-1>(SIZE_MAX-row)/g->stride) return invalid(EINVAL);
+        size_t bytes=(g->height-1)*g->stride+row;
+        if(g->bytes<bytes || (uintptr_t)g->bits>UINTPTR_MAX-(bytes-1)) return invalid(EINVAL);
+    }
+    if(!clip_count) return 0;
+    struct plan p={0};
+    if(background && rectangle(&p,surface,clips,clip_count,background->x1,background->y1,
+        background->x2,background->y2,background_color)) goto error;
+    for(unsigned i=0;i<count;++i) {
+        const struct ps2_bitmap_glyph *g=&glyphs[i];
+        if(!g->width || !g->height) continue;
+        for(unsigned y=0;y<g->height;++y) {
+            const unsigned char *row=g->bits+y*g->stride;
+            unsigned x=0;
+            while(x<g->width) {
+                while(x<g->width && !bit(row,x,msb_first)) ++x;
+                unsigned left=x;
+                while(x<g->width && bit(row,x,msb_first)) ++x;
+                if(x>left && rectangle(&p,surface,clips,clip_count,(int64_t)g->x+left,(int64_t)g->y+y,
+                    (int64_t)g->x+x,(int64_t)g->y+y+1,foreground)) goto error;
+            }
+        }
+    }
+    if(!p.count) { free(p.spans); return 0; }
+    uint32_t saved_color=r->target,saved_depth=r->depth;
+    if(ps2_render_bind(r,target,0)) goto error;
+    for(unsigned i=0;i<p.count;++i) {
+        const struct span *s=&p.spans[i];
+        if(ps2_render_fill(r,s->x,s->y,s->width,s->height,s->color)) goto error;
+    }
+    if(ps2_render_flush(r) || ps2_render_bind(r,saved_color,saved_depth)) goto error;
+    free(p.spans); return 0;
+error:
+    free(p.spans); return -1;
+}
--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_gs_bitmap.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_GS_BITMAP_H
+#define PS2_GS_BITMAP_H
+#include "ps2_gs_render.h"
+#include <stddef.h>
+struct ps2_bitmap_box { int32_t x1,y1,x2,y2; };
+struct ps2_bitmap_glyph {
+    int32_t x,y;
+    unsigned width,height;
+    const unsigned char *bits;
+    size_t bytes,stride;
+};
+/* Decode existing monochrome font bits into native GS rectangle commands.
+ * No destination pixels, CPU framebuffer, readback or software rasterizer.
+ * All coordinates/clips are relative to the supplied owned color target.
+ * Preflight the entire command plan before fencing/submitting anything.
+ * One submission thread; restore the previous Mesa color/depth binding.
+ */
+int ps2_bitmap_draw(struct ps2_render_client *,uint32_t target,
+    const struct ps2_bitmap_glyph *,unsigned count,
+    const struct ps2_bitmap_box *,unsigned clip_count,int msb_first,
+    uint32_t foreground,const struct ps2_bitmap_box *background,uint32_t background_color);
+#endif
