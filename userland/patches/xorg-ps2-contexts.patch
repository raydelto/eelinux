--- /dev/null
+++ b/hw/xfree86/drivers/ps2/ps2_context_bridge.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: MIT */
+#include "ps2_context_bridge.h"
+Bool ps2_exa_context_bridge_prepare(ScreenPtr screen,struct ps2_exa_context_bridge *b,
+    struct ps2_surface_exa *exa,struct pipe_context *context)
+{
+    struct ps2_render_client *render=ps2_pipe_context_render(context);
+    if (!screen || !b || !exa || !render || render->gs!=exa->gs || b->attached ||
+        ps2_pipe_context_acquire(context)) return FALSE;
+    if (!ps2_exa_render_bridge_prepare(screen,&b->ordering,exa,render)) {
+        ps2_pipe_context_release(context); return FALSE;
+    }
+    b->context=context; b->attached=1; return TRUE;
+}
+void ps2_exa_context_bridge_cleanup(struct ps2_exa_context_bridge *b)
+{
+    if (!b || !b->attached) return;
+    /* Restore the entire pre-attachment table, including removing any texture
+     * callbacks installed afterwards. All operations are synchronous. The
+     * bridge and later texture private structures stay screen-owned through
+     * CloseScreen, but no restored callback reaches their released context. */
+    b->ordering.exa->driver=b->ordering.original;
+    struct pipe_context *context=b->context;
+    b->context=NULL; b->attached=0;
+    ps2_pipe_context_release(context);
+}
--- /dev/null
+++ b/hw/xfree86/drivers/ps2/ps2_context_bridge.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_CONTEXT_BRIDGE_H
+#define PS2_CONTEXT_BRIDGE_H
+#include "ps2_render_bridge.h"
+#include "ps2_context_link.h"
+struct ps2_exa_context_bridge {
+    struct ps2_exa_render_bridge ordering;
+    struct pipe_context *context;
+    int attached;
+};
+/* Zero-initialize this structure. Install after surface preparation, before
+ * texture preparation/exaDriverInit. No other callback owners may be inserted
+ * into the table before this bridge is detached.
+ * Cleanup restores every callback before releasing its Mesa lifetime lease.
+ * The structure remains screen-owned until the screen is closed. */
+Bool ps2_exa_context_bridge_prepare(ScreenPtr,struct ps2_exa_context_bridge *,
+    struct ps2_surface_exa *,struct pipe_context *);
+void ps2_exa_context_bridge_cleanup(struct ps2_exa_context_bridge *);
+#endif
--- /dev/null
+++ b/hw/xfree86/drivers/ps2/ps2_context_link.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_CONTEXT_LINK_H
+#define PS2_CONTEXT_LINK_H
+/* Narrow lifetime interface: Xorg need not include Gallium's internal headers
+ * or expose its macro namespace. The implementations live in the Mesa PS2
+ * context library, linked by the eventual native DDX. */
+struct pipe_context;
+struct ps2_render_client;
+struct ps2_render_client *ps2_pipe_context_render(struct pipe_context *);
+int ps2_pipe_context_acquire(struct pipe_context *);
+void ps2_pipe_context_release(struct pipe_context *);
+#endif
