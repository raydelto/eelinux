+/* SPDX-License-Identifier: MIT */
+/* GS sample counting replaces EXA's software-only geometric mask rasterizer. */
+#include "ps2_render_geometry.h"
+#include "ps2_render_raster.h"
+#include "windowstr.h"
+#include "dixstruct.h"
