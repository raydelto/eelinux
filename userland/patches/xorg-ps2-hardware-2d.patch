+        ps2_surface_set_depth(gs,f->packed,32) || ps2_surface_create(gs,64,32,32,&f->words) ||
+        ps2_surface_create(gs,64,32,32,&f->scratch) || ps2_surface_create(gs,64,32,32,&f->rgba) ||
