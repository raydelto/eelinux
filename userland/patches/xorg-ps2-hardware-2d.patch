+done:
+    error=errno;
+    for(unsigned i=0;i<9;++i)if(owned[i] && !gs->error && ps2_surface_destroy(gs,owned[i])){
+        if(!result)error=errno;
+        result=-1;
+    }
+    errno=error;return result;
+}
