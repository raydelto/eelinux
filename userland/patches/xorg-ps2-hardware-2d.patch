+int ps2_native_saturate_alpha(struct ps2_filter_workspace *,uint32_t source,
+    uint32_t mask,uint32_t destination,uint32_t low,uint32_t high,uint32_t extra,
+    uint32_t factor,uint32_t palette,unsigned width);
