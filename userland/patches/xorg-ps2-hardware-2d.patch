+            (c->gs!=gs || c->core || c->bpp!=8 || (c->alpha_bits!=4 && c->alpha_bits!=8) || c->surface!=surfaces[i]))return 0;
+        const struct ps2_picture_bitmap *b=alias_bytes(a,i);
