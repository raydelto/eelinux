+        (f->source_kind==PS2_FILTER_RGB && s->bits_per_pixel!=16 && s->bits_per_pixel!=32) ||
+        (f->source_kind!=PS2_FILTER_RGB && f->source_kind!=PS2_FILTER_CONSTANT && s->bits_per_pixel!=32) ||
+        (f->source_kind!=PS2_FILTER_CONSTANT &&
