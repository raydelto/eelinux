+        transfer(w,ea,predicate,width,height,PS2GS_TRANSFER_SUBTRACT) ||
+        select_plane(w,exponent,eb,ea,predicate,p,width,height) ||
+        transfer(w,ea,distance,width,height,PS2GS_TRANSFER_REPLACE) ||
