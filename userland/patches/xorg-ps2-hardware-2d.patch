+#include <errno.h>
+#include <string.h>
+static int page(struct ps2_surface_client *gs,uint32_t h)
+{
+    const struct ps2_surface *s=ps2_surface_lookup(gs,h);
+    return h && s && s->bits_per_pixel==32 && s->width==64 && s->height==32;
