+            if(ps2_surface_channel_map_region(gs,f->packed,f->scratch,f->palette,(x+k)/4,y,k,0,1,1,0xffffff,(x+k)%4))return -1;
+        if(ps2_surface_alpha_write(gs,f->scratch,f->rgba,f->surface,f->palette,x,y,w,1,0xff000000))return -1;
+        x+=w;
