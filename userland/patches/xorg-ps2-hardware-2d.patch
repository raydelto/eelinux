+            for(unsigned i=0;i<256;++i)table[i]=i<<(part*8);
+            if(ps2_surface_map_palette(gs,f->palette,table))return -1;
+            for(unsigned k=0;k<w;++k)
+                if(ps2_surface_channel_map_region(gs,f->packed,f->words,f->palette,(x+k)/2,y,k,0,1,1,
