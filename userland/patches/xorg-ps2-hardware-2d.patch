+        w->difference[0],w->difference[1],w->difference[2],w->difference[3],
+        w->borrow,w->carry,w->saturated,w->term,w->temporary,w->selected,w->retained,
+        f->tap,f->term,f->sum[0],f->sum[1],f->sum[2],f->saturated,f->carry,f->sum[3]};
