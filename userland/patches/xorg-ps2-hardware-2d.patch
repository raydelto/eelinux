+     * Coefficients and these four uniform bytes contain no sampled colour. */
+    float factor=(float)(coefficient<0?-(int64_t)coefficient:(int64_t)coefficient)*0x1p-32f;
+    uint32_t word;memcpy(&word,&factor,4);
