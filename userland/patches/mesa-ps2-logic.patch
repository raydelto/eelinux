+/* SPDX-License-Identifier: MIT */
+#ifndef PS2_GS_LOGIC_CLIENT_H
+#define PS2_GS_LOGIC_CLIENT_H
+#include "ps2_gs_surface.h"
+#include "ps2-gs-logic.h"
+/* Native pixel values; alpha is preserved. Sticky hardware failure, one
+ * drawing thread, pre-effect EAGAIN retries only. No destination mapping. */
+int ps2_surface_solid_logic(struct ps2_surface_client *, uint32_t handle,
+    unsigned x, unsigned y, unsigned width, unsigned height,
+    uint32_t color, uint32_t plane_mask, unsigned alu);
+#endif
--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2-gs-logic.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_PS2_GS_LOGIC_H
+#define _UAPI_PS2_GS_LOGIC_H
+#include "ps2-gs-texture.h"
+
+#define PS2GS_HW_SOLID_LOGIC (1U << 8)
+/* Constant-source Boolean raster operations, numbered as X11 GXclear..GXset.
+ * color/plane_mask are native RGB555 (CT16) or RGB888 (CT32) pixel bits.
+ * Alpha is always preserved. The kernel uses at most two masked GS sprites:
+ * constant bits are copied; inverted bits use (255 - destination RGB).
+ * No readback, CPU destination pixels, user VRAM addresses or shaders.
+ * Ownership, KD_GRAPHICS, epoch invalidation and sticky failure rules match
+ * the surface interface. Each request is validated before any drawing.
+ */
+struct ps2gs_solid_logic {
+	__u32 abi, handle, x, y, width, height;
+	__u32 color, plane_mask, alu, reserved;
+};
+#define PS2GS_SOLID_LOGIC _IOW('G', 0x7b, struct ps2gs_solid_logic)
+#endif
--- /dev/null
+++ b/src/gallium/drivers/ps2/ps2_logic.c
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT */
+#include "ps2_logic.h"
+#include <errno.h>
+int ps2_pipe_solid_logic(struct pipe_context *context, struct pipe_resource *resource,
+    const struct pipe_box *box, uint32_t color, uint32_t plane_mask, unsigned alu)
+{
+    if (ps2_pipe_context_acquire(context)) return -1;
+    struct ps2_render_client *render = ps2_pipe_context_render(context);
+    uint32_t handle = 0;
+    int result = -1;
+    if (!box || box->x < 0 || box->y < 0 || box->z || box->depth != 1 ||
+        box->width <= 0 || box->height <= 0 || alu > 15) { errno = EINVAL; goto out; }
+    if (resource) {
+        if (resource->screen != context->screen ||
+            (resource->format != PIPE_FORMAT_R8G8B8X8_UNORM &&
+             resource->format != PIPE_FORMAT_R5G5B5X1_UNORM)) { errno = ENOTSUP; goto out; }
+        struct ps2_resource *r = (void *)resource;
+        if (r->owner != render->gs || !r->handle) { errno = EXDEV; goto out; }
+        handle = r->handle;
+    }
+    const struct ps2_surface *buffer = ps2_surface_lookup(render->gs, handle);
+    if (!buffer || (unsigned)box->x >= buffer->width || (unsigned)box->y >= buffer->height ||
+        (unsigned)box->width > buffer->width-box->x ||
+        (unsigned)box->height > buffer->height-box->y) { errno = EINVAL; goto out; }
+    uint32_t bits = buffer->bits_per_pixel == 16 ? 0x7fff : 0xffffff;
+    if ((color | plane_mask) & ~bits) { errno = EINVAL; goto out; }
+    if (!(render->gs->caps.features & PS2GS_HW_SOLID_LOGIC)) { errno = ENOTSUP; goto out; }
+    if (ps2_render_flush(render)) goto out;
+    result = ps2_surface_solid_logic(render->gs, handle, box->x, box->y,
+        box->width, box->height, color, plane_mask, alu);
+out:
+    ps2_pipe_context_release(context);
+    return result;
+}
