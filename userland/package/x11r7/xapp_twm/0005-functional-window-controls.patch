+/* Shade only the frame.  The client remains mapped at its original size,
+ * so no resize or withdrawal is delivered to the application.  SetupFrame
+ * keeps the logical full height current, including client configure requests
+ * and icon-manager growth while shaded. */
+void
+SetWindowShade(TwmWindow *tmp, Bool shaded)
+{
+    if (!tmp->title_height || tmp->shaded == shaded)
+        return;
+
+    tmp->shaded = shaded;
+    XResizeWindow(dpy, tmp->frame, (unsigned) tmp->frame_width,
+                  (unsigned) (shaded ? tmp->title_height : tmp->frame_height));
+    if (HasShape) {
+        /* Remove any previous client/squeezed shape before rebuilding it. */
+        XShapeCombineMask(dpy, tmp->frame, ShapeBounding, 0, 0, None, ShapeSet);
+        XShapeCombineMask(dpy, tmp->frame, ShapeClip, 0, 0, None, ShapeSet);
+        SetFrameShape(tmp);
+    }
+}
