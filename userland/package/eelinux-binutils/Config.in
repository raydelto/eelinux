config BR2_PACKAGE_EELINUX_BINUTILS
	bool "native GNU Binutils 2.47 for eeLinux"
	depends on BR2_mips_r5900
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_USE_WCHAR
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_PACKAGE_BINUTILS_TARGET
	select BR2_PACKAGE_ZLIB
	help
	  Build GNU assembler, linker and binary tools to run on R5900 Linux.
	  The version and hashes are independent of Buildroot's host tools.
	  Use disk storage for the native GNU development profile.
