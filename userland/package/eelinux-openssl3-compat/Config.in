config BR2_PACKAGE_EELINUX_OPENSSL3_COMPAT
	bool "OpenSSL 3 compatibility libraries and SDK"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LIBOPENSSL
	select BR2_PACKAGE_ZLIB
	help
	  Maintained OpenSSL 3 LTS ABI for existing applications, alongside
	  current OpenSSL. Providers, engines, headers and pkgconfig files use
	  private paths and do not replace the default OpenSSL SDK.
